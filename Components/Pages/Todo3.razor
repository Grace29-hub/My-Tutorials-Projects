@page "/todo3"
@rendermode InteractiveServer

<PageTitle>Todo</PageTitle>

<!--Use count to track todos-->
<h3>Todo (@todos.Count(t => !t.IsDone))</h3>

<!--Display the todo list using the for each loop-->
<ul>
    @foreach(var todo in todos)
    {
        <li>
            <input type="checkbox" @bind="todo.IsDone">
            <input @bind="todo.Title" />
        </li>
    }
</ul>

<!--Add todos-->
<input @bind="newTodo" />
<button @onclick="AddTodo">Add Todo</button>

@code{
    /*Declare the new todo*/
    string newTodo = "";

    /*create a list for the new todos*/
    List<TodoItem> todos = new List<TodoItem>();

    /*Create a public class*/
    public class TodoItem
    {
        public string Title {get; set;}
        public bool IsDone {get; set;}
    }

    /*use the if statement to add new todos*/
    private void AddTodo(MouseEventArgs e)
    {
        if(!string.IsNullOrWhiteSpace(newTodo))
        {
            todos.Add(new TodoItem {Title = newTodo});
            newTodo = "";
        }
    }
}